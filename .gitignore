# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# DVC — .dvc/ config dir and *.dvc pointer files are tracked in git
# DVC manages its own .gitignore inside data/ and models/
/data/raw/
/data/interim/
/data/processed/
/models/*.joblib
/models/*.onnx
/models/*.pt
/models/*.bin

# MLflow
mlflow.db
mlruns/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key
*.pem
*_accessKeys.csv

# Build artifacts
*.so
*.dylib

# Metrics (generated) — tracked in git per dvc.yaml cache: false
# metrics/ is intentionally NOT ignored

# Logs
*.log
logs/

# Claude Code agent workspace
.agents/
skills-lock.json

# SageMaker run logs
logs/sagemaker/

# Session activity logs (written by .claude/log_session.ps1 hook)
/logs/

# Local-only Claude Code settings (hooks, personal overrides)
.claude/settings.local.json
